<?xml version="1.0" encoding="utf-8"?>
<mujoco model="mouse_forelimb_right_hand_v21">
  <!--
    Mouse right forelimb musculoskeletal model with an articulated hand.
    Proximal arm (shoulder/elbow/forearm/wrist) is unchanged from v18:
    same STL meshes, same muscle sites, same joints/ranges.

    v21: sh_rotation, sh_extension, sh_elv, and elbow are now driven by the
    12 muscles from mouse_forelimb_right_janelia_moving_shoulder_muscle.xml
    (Pec_C, Lat, AD, PD, MD, Triceps_Lateral, Triceps_Long, Brachialis,
    Biceps_Long, Supraspinatus, Infraspinatus, Subscapularis) instead of
    torque motors. sh_tx/ty/tz, forearm_supination, wrist_flexion,
    rz_N_L_C_right, and all hand joints remain torque-motor driven.

    v19: the old 104-piece flat, unjointed Retopo_*.stl hand mesh is replaced
    with Shravan's articulated hand (carpals -> metacarpals -> phalanx
    chains, OBJ meshes, models/v19/), matched to the old hand via
    models/shravan_forearm/old_to_new_mesh_mapping.csv. See
    scratch/plans/PLAN_v19_hand_model.md for the full design rationale.

    Joint summary (4 DOF arm, unchanged from v18):
      sh_elv:       shoulder elevation,  pitch about Y, [-70, 0] deg
      sh_extension: shoulder extension,  yaw about Z,   [-70, 40] deg
      sh_rotation:  shoulder rotation,   roll about X,  [-25, 89] deg
      elbow:        elbow flex/extend,   about X,       [-70, 80] deg

    Wrist/hand joints (new in v19 except forearm_supination/wrist_flexion):
      forearm_supination: forearm twist,      about Y, [-90, 90] deg (v17)
      wrist_flexion:      wrist flex/extend,   about X, [-60, 60] deg (v18)
      rz_N_L_C_right:     wrist radial/ulnar deviation, about Z, [-15, 15] deg
      rx_Phalanx_hand_1_x_right: MCP flex,    about X, [-20, 90] deg (x=1..5)
      rz_Phalanx_hand_1_x_right: MCP spread,  about Z, [-20, 20] deg (x=1..5)
        (no MCP twist axis: fully rigid, per Eric)
      rx_Phalanx_hand_2_x_right: PIP flex,    about X, [0, 100] deg (x=1..5)
      Phalanx_hand_3_x_right (DIP, x=2..5) is frozen: no joint, just marks
        where the dx_t keypoint sits (digit 1/thumb has no 3rd segment).
      Metacarpals, carpals, and all sesamoids are rigid (no joints), matching
      Shravan's own model.
  -->

  <compiler angle="degree" meshdir="/mnt/vast/niyo/stac-mjx/models/v21">
    <!-- v21 STAC variant: muscles commented out below, so no muscle length
         range to compute, lengthrange directive dropped (see actuator/
         tendon comment-out below for why). -->
  </compiler>

  <option integrator="RK4" timestep="0.001" solver="CG" iterations="6" ls_iterations="6"/>

  <default>
    <joint limited="true" solreflimit="0.01 1" solimplimit="0.99 0.9999 0" armature="1e-9" damping="1e-6" stiffness="1e-12"/>
    <muscle ctrllimited="true" ctrlrange="0 1"/>

    <geom contype="0" conaffinity="0"/>
    <default class="hand_visual">
      <geom contype="0" conaffinity="0"/>
    </default>
  </default>

  <size njmax="1000" nconmax="400" nuser_jnt="1"/>

  <visual>
    <headlight diffuse=".5 .5 .5" specular="1 1 1"/>
    <global offwidth="2048" offheight="1536"/>
    <quality shadowsize="8192"/>
    <scale framelength="0.5" framewidth="0.01"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="0.6 0.8 1" width="256" height="1536"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    <mesh name="clavicle_right_mesh" file="clavicle_right.stl"/>
    <mesh name="scapula_right_mesh" file="scapula_right.stl"/>
    <mesh name="humerus_right_mesh" file="humerus_right.stl"/>
    <mesh name="radius_right_mesh" file="radius_right.stl"/>
    <mesh name="ulna_right_mesh" file="ulna_right.stl"/>
    <!-- Hand meshes: Shravan's articulated hand (carpals/metacarpals/phalanges/
         sesamoids), OBJ format, matched to the old Retopo hand via
         models/shravan_forearm/old_to_new_mesh_mapping.csv. -->
    <material name="bone" specular="0.5" shininess="0.9" reflectance="0.0" rgba="0.559 0.559 0.559 1.0"/>
    <mesh name="Capitate_right_bone" file="Capitate_right_bone.obj"/>
    <mesh name="Centrale_right_bone" file="Centrale_right_bone.obj"/>
    <mesh name="Falsiformis_right_bone" file="Falsiformis_right_bone.obj"/>
    <mesh name="Hamate_right_bone" file="Hamate_right_bone.obj"/>
    <mesh name="Metacarpal_hand_1_right_bone" file="Metacarpal_hand_1_right_bone.obj"/>
    <mesh name="Metacarpal_hand_2_right_bone" file="Metacarpal_hand_2_right_bone.obj"/>
    <mesh name="Metacarpal_hand_3_right_bone" file="Metacarpal_hand_3_right_bone.obj"/>
    <mesh name="Metacarpal_hand_4_right_bone" file="Metacarpal_hand_4_right_bone.obj"/>
    <mesh name="Multangular_right_bone" file="Multangular_right_bone.obj"/>
    <mesh name="Navicular_lunate_right_bone" file="Navicular_lunate_right_bone.obj"/>
    <mesh name="Phalanx_hand_1_1_right_bone" file="Phalanx_hand_1_1_right_bone.obj"/>
    <mesh name="Phalanx_hand_1_2_right_bone" file="Phalanx_hand_1_2_right_bone.obj"/>
    <mesh name="Phalanx_hand_1_3_right_bone" file="Phalanx_hand_1_3_right_bone.obj"/>
    <mesh name="Phalanx_hand_1_4_right_bone" file="Phalanx_hand_1_4_right_bone.obj"/>
    <mesh name="Phalanx_hand_1_5_right_bone" file="Phalanx_hand_1_5_right_bone.obj"/>
    <mesh name="Phalanx_hand_2_1_right_bone" file="Phalanx_hand_2_1_right_bone.obj"/>
    <mesh name="Phalanx_hand_2_2_right_bone" file="Phalanx_hand_2_2_right_bone.obj"/>
    <mesh name="Phalanx_hand_2_3_right_bone" file="Phalanx_hand_2_3_right_bone.obj"/>
    <mesh name="Phalanx_hand_2_4_right_bone" file="Phalanx_hand_2_4_right_bone.obj"/>
    <mesh name="Phalanx_hand_2_5_right_bone" file="Phalanx_hand_2_5_right_bone.obj"/>
    <mesh name="Phalanx_hand_3_2_right_bone" file="Phalanx_hand_3_2_right_bone.obj"/>
    <mesh name="Phalanx_hand_3_3_right_bone" file="Phalanx_hand_3_3_right_bone.obj"/>
    <mesh name="Phalanx_hand_3_4_right_bone" file="Phalanx_hand_3_4_right_bone.obj"/>
    <mesh name="Phalanx_hand_3_5_right_bone" file="Phalanx_hand_3_5_right_bone.obj"/>
    <mesh name="Pisiform_right_bone" file="Pisiform_right_bone.obj"/>
    <mesh name="Sesamoid_elbow_right_bone" file="Sesamoid_elbow_right_bone.obj"/>
    <mesh name="Sesamoid_hand_a_right_bone" file="Sesamoid_hand_a_right_bone.obj"/>
    <mesh name="Sesamoid_hand_b_right_bone" file="Sesamoid_hand_b_right_bone.obj"/>
    <mesh name="Sesamoid_hand_c_right_bone" file="Sesamoid_hand_c_right_bone.obj"/>
    <mesh name="Sesamoid_hand_d_right_bone" file="Sesamoid_hand_d_right_bone.obj"/>
    <mesh name="Sesamoid_hand_e_right_bone" file="Sesamoid_hand_e_right_bone.obj"/>
    <mesh name="Sesamoid_hand_f_right_bone" file="Sesamoid_hand_f_right_bone.obj"/>
    <mesh name="Sesamoid_hand_g_right_bone" file="Sesamoid_hand_g_right_bone.obj"/>
    <mesh name="Sesamoid_hand_h_right_bone" file="Sesamoid_hand_h_right_bone.obj"/>
    <mesh name="Sesamoid_hand_i_right_bone" file="Sesamoid_hand_i_right_bone.obj"/>
    <mesh name="Sesamoid_hand_j_right_bone" file="Sesamoid_hand_j_right_bone.obj"/>
    <mesh name="Sesamoid_hand_k_right_bone" file="Sesamoid_hand_k_right_bone.obj"/>
    <mesh name="Sesamoid_hand_l_right_bone" file="Sesamoid_hand_l_right_bone.obj"/>
    <mesh name="Sesamoid_hand_m_right_bone" file="Sesamoid_hand_m_right_bone.obj"/>
    <mesh name="Triangular_right_bone" file="Triangular_right_bone.obj"/>
    <mesh name="mesh.260_bone" file="mesh.260_bone.obj"/>
  </asset>

  <worldbody>
    <light directional="true"/>
    <!-- ========================= -->
    <!-- Joystick geometry from compute_joystick_geometry.py (static
         base/ball/bottom calibration, not per-trial mocap tracking): shaft
         14.363mm (bottom to base), ball 1.822mm above base, shaft tilted
         39.4 degrees off vertical (not upright, per direct measurement).
         Fixed in world, not attached to the arm. joystick_base sits at the
         bottom/mount point (translates in world x/y only via
         x_slide/y_slide); the child "joystick" body carries the fixed tilt
         rotation so the shaft+ball geometry (unchanged local frame) point
         the right physical direction. -->
    <body name="joystick_base" pos="0.02754416 0.00213547 0.04439829">
      <!-- Real-joystick-measured spring/damping coefficients (per Eric):
           Kx=0.0148 N/mm, Ky=0.0112 N/mm -> x1000 for MuJoCo's N/m slide-joint
           stiffness; Cx=0.0099 Ns/m, Cy=0.0082 Ns/m already match MuJoCo's
           native Ns/m damping convention directly (no scaling needed). These
           don't matter for STAC (no dynamics) but keep the model consistent/
           reusable for future dynamics work. -->
      <joint name="x_slide" type="slide" axis="1 0 0" limited="true" range="-0.006 0.006" damping="0.0099" stiffness="14.8"/>
      <joint name="y_slide" type="slide" axis="0 1 0" limited="true" range="-0.006 0.006" damping="0.0082" stiffness="11.2"/>
      <!-- z_slide: NOT a real physical DOF of the joystick rig (which only
           moves in x/y); added to absorb per-trial registration noise.
           joystick_base's position is fixed from ONE static calibration
           measurement transformed via an averaged (across many trials)
           rotation; each individual trial's own Procrustes rotation fit
           (computed from that trial's own noisy resting arm pose) differs
           slightly from that average, and since the joystick sits far from
           the arm anchor point used for the fit, that small rotational
           difference is amplified into a position error, observed as a
           consistent per-trial Z-only bias (~1-4mm, no consistent X/Y bias)
           between the mocap target and the model's fitted site, since
           there was no DOF to correct it. A small z_slide lets STAC absorb
           this the same way x_slide/y_slide already absorb the X/Y version
           of the same noise, rather than showing up as irreducible
           misalignment. -->
      <joint name="z_slide" type="slide" axis="0 0 1" limited="true" range="-0.006 0.006" damping="0.01" stiffness="15"/>

      <!-- small circular base (mount plate) -->
      <geom name="circular_base" type="cylinder" size="0.0015 0.00025" pos="0 0 0"
            rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
      <!-- cosmetic mount post extending down toward the rig floor, below
           js_bottom (this body's own origin): purely visual, not a tracked
           keypoint, doesn't affect fitting. Added because the real rig's
           post visibly extends further down than js_bottom's own measured
           point; length is an approximate visual match, not a calibrated
           measurement. -->
      <geom name="mount_post" type="cylinder" size="0.001 0.01" pos="0 0 -0.01"
            rgba="0.5 0.5 0.5 1" contype="1" conaffinity="2"/>

      <!-- shaft + ball, tilted to the measured shaft direction -->
      <body name="joystick" pos="0 0 0" quat="0.94147265 -0.29173666 -0.16887560 0.00000000">
        <!-- shaft: radius 0.001 m (2x visual, per Eric, not re-measured,
             cosmetic only), half-length 0.0071815 m (total 0.014363 m =
             measured bottom->base, unchanged) -->
        <geom name="joystick_geom" type="cylinder" size="0.001 0.0071815" pos="0 0 0.0071815"
              rgba="0 0 1 1" contype="1" conaffinity="2"/>
        <!-- ball radius 0.002 m (2x visual, per Eric, not re-measured,
             cosmetic only), center 0.001822 m above the base/top-of-shaft
             point (measured), i.e. at 0.014363+0.001822, unchanged -->
        <geom name="joystick_ball" type="sphere" size="0.002" pos="0 0 0.016184"
              rgba="0 0 1 1" contype="1" conaffinity="2"/>
        <inertial mass="0.001" pos="0 0 0.0071815" diaginertia="1e-7 1e-7 1e-7"/>
      </body>
    </body>

    <body name="ground" euler="0 0 0">
      <camera name="my_camera" pos="0.04 .004 0.037" fovy="20" quat="0.6532815 0.2705981 0.2705981 0.6532815"/>
      <camera name="close-profile" pos="0.04 .004 0.037" fovy="20" quat="0.6532815 0.2705981 0.2705981 0.6532815"/>
      <camera name="janelia_cam" pos="0.020 -0.035 0.065" xyaxes="1 0 0 0 0 1" fovy="55"/>
    </body>

    <!-- Shoulder base: allows small translational movement -->
    <body name="shoulder_base" pos="0 0 0">
      <joint name="sh_tx" type="slide" axis="1 0 0" range="-0.01 0.01" damping="0.1" stiffness="10" springref="0"/>
      <joint name="sh_ty" type="slide" axis="0 1 0" range="-0.01 0.01" damping="0.1" stiffness="10" springref="0"/>
      <joint name="sh_tz" type="slide" axis="0 0 1" range="-0.01 0.01" damping="0.1" stiffness="10" springref="0"/>

    <!-- Clavicle: fixed to shoulder_base -->
    <body name="clavicle" pos="0.014801 0.015912 0.071520" quat="0.149881 0.982988 -0.104926 0.016135">
      <!-- v21: inertial computed from mesh geometry via density (was a rough isotropic
           placeholder: mass=0.0005, diaginertia equal on all 3 axes -> a ~0.77mm equivalent
           cube, not shaped like the actual bone). density chosen to preserve the same
           total mass (0.0005 kg) while letting the inertia tensor reflect the real mesh shape. -->
      <geom type="mesh" mesh="clavicle_right_mesh" density="160885.51"/>

      <!-- Muscle origins on clavicle -->
      <site name="Pec_C_Origin" pos="0.001685 -0.001215 0.000368" rgba=".1 .2 .6 .5" size="0.0002"/>
      <site name="AD_Origin" pos="0.001041 0.005061 -0.000018" rgba=".1 .2 .6 .5" size="0.0002"/>
      <site name="MD_Origin" pos="0.000438 0.007765 0.001086" rgba=".1 .2 .6 .5" size="0.0002"/>
      <site name="Biceps_Long_Origin" pos="0.000819 0.005480 0.000670" rgba=".1 .2 .6 .5" size="0.0002"/>

      <!-- Scapula: fixed to clavicle (no joints) -->
      <body name="scapula" pos="-0.008751 0.004141 0.006510" quat="0.639001 0.064200 0.435113 -0.631057">
        <!-- v21: density chosen to preserve mass=0.001 kg (was an isotropic placeholder
             inertia, ~1.73mm equivalent cube) while shaping inertia from the real mesh. -->
        <geom type="mesh" mesh="scapula_right_mesh" density="34044.87"/>

        <!-- Muscle origins on scapula -->
        <site name="Lat_Origin" pos="-0.002844 0.001022 0.002735" rgba=".1 .2 .6 .5" size="0.0002"/>
        <site name="PD_Origin" pos="-0.001048 0.003363 -0.001202" rgba=".1 .2 .6 .5" size="0.0002"/>
        <site name="Triceps_Long_Origin" pos="-0.000384 0.008800 -0.000243" rgba=".1 .2 .6 .5" size="0.0002"/>
        <site name="Supraspinatus_Origin" pos="0.001304 0.000580 -0.001051" rgba=".1 .6 .2 .5" size="0.0002"/>
        <site name="Infraspinatus_Origin" pos="-0.001242 -0.000022 0.000952" rgba=".1 .6 .2 .5" size="0.0002"/>
        <site name="Subscapularis_Origin" pos="0.002313 0.001802 -0.001403" rgba=".1 .6 .2 .5" size="0.0002"/>

        <!-- Humerus: 3 DOF shoulder (elevation, extension, rotation) -->
        <body name="humerus" pos="0.000000 0.010813 -0.000000" quat="-0.371895 -0.035161 -0.437159 -0.818138">
          <!-- Joint definitions from vnl-playground eric/janelia branch (source of truth) -->
          <joint name="sh_rotation" type="hinge" pos="0 0 0" axis="0 1 0" armature="4e-10" damping="1e-6" stiffness="0" range="-70 40" limited="true"/>
          <joint name="sh_extension" type="hinge" pos="0 0 0" axis="0 0 1" armature="4e-10" damping="1e-6" stiffness="0" range="-80 65" limited="true"/>
          <!-- v21: sh_rotation/sh_elv/elbow ranges restored to moving_shoulder_muscle.xml's ranges -
               the muscle force-length calibration (lengthrange) is computed by sweeping each joint through
               its declared range, so muscle-driven joints must keep the ranges they were tuned against.
               sh_extension is widened from donor's -70/40 to -80/65 per Eric's request (2026-07-14):
               -90/90 was tried first but slams to the new limit under Biceps_Long drive (0.44 -> 1.57
               vs donor), breaking the close match; -80/65 keeps Biceps_Long tracking donor closely
               (0.494 vs 0.436) while still giving more room than donor's original range. -->
          <joint name="sh_elv" type="hinge" pos="0 0 0" axis="1 0 0" armature="4e-10" damping="1e-6" stiffness="0" range="-60 89" limited="true"/>
          <!-- v21: density chosen to preserve mass=0.0001258 kg (donor-matched); was an
               isotropic placeholder inertia (~26.75mm equivalent cube vs the real ~10mm
               bone) - now shaped from the actual mesh geometry. -->
          <geom type="mesh" mesh="humerus_right_mesh" density="4085.61"/>

          <!-- Muscle sites on humerus -->
          <site name="Pec_C_Insertion" pos="0.001309 0.004713 0.001702" rgba=".1 .2 .6 .5" size="0.0002"/>
          <site name="Lat_Insertion" pos="-0.000707 0.002131 0.000500" rgba=".1 .2 .6 .5" size="0.0002"/>
          <site name="AD_Insertion" pos="0.001491 0.004709 0.001681" rgba=".1 .2 .6 .5" size="0.0002"/>
          <site name="PD_Insertion" pos="0.001547 0.004007 0.001475" rgba=".1 .2 .6 .5" size="0.0002"/>
          <site name="MD_Insertion" pos="0.001468 0.004771 0.001558" rgba=".1 .2 .6 .5" size="0.0002"/>
          <site name="Triceps_Lateral_Origin" pos="0.000793 0.000307 -0.000113" rgba=".1 .2 .6 .5" size="0.0002"/>
          <site name="Brachialis_Origin" pos="0.000321 0.000785 -0.000406" rgba=".1 .2 .6 .5" size="0.0002"/>

          <!-- Elbow wrapping cylinder and side sites -->
          <!-- <geom name="elbow_wrap" type="cylinder" pos="0 0.010368 0"
                quat="0.707107 0 0.707107 0" size="0.0012 0.003"
                group="2" rgba="0.3 0.3 0.8 0.2"/> -->
          <site name="Flexor_Side" pos="0.000000 0.010368 0.003000" rgba=".2 .8 .2 .3" size="0.0002"/>
          <site name="Extensor_Side" pos="0.000000 0.010368 -0.003000" rgba=".8 .2 .2 .3" size="0.0002"/>

          <!-- Rotator cuff muscle insertions on humerus -->
          <site name="Supraspinatus_Insertion" pos="0.000982 -0.000624 -0.000019" rgba=".1 .6 .2 .5" size="0.0002"/>
          <site name="Infraspinatus_Insertion" pos="0.001128 -0.000025 0.000144" rgba=".1 .6 .2 .5" size="0.0002"/>
          <site name="Subscapularis_Insertion" pos="-0.001173 -0.000348 -0.000056" rgba=".1 .6 .2 .5" size="0.0002"/>

          <!-- Ulna + Radius: 1 DOF elbow flexion/extension -->
          <body name="ulna" pos="0.000000 0.010368 -0.000000" quat="0.747902 0.663606 -0.008811 0.013871">
            <joint name="elbow" pos="0 0 0" axis="1 0 0" armature="4e-10" damping="1e-6" stiffness="0" range="-70 80" limited="true"/>
            <!-- v21: density chosen to preserve combined mass=0.0001258 kg across all 3
                 geoms (donor-matched); was an isotropic placeholder inertia (~26.75mm
                 equivalent cube vs the real ~10mm bone) - now shaped from the actual mesh. -->
            <geom type="mesh" mesh="ulna_right_mesh" density="6790.82"/>
            <geom type="mesh" mesh="radius_right_mesh" density="6790.82"/>
            <geom name="Sesamoid_elbow_right_bone" mesh="Sesamoid_elbow_right_bone" type="mesh" material="bone" class="hand_visual" pos="0.00117067 0.00050090 0.00006615" quat="0.22233319 0.10212072 0.01283039 0.96952292" density="6790.82"/>

            <!-- Muscle insertions on radius/ulna -->
            <site name="Triceps_Lateral_Insertion" pos="0.000146 -0.001278 -0.000605" rgba=".1 .2 .6 .5" size="0.0002"/>
            <site name="Triceps_Long_Insertion" pos="-0.000725 -0.002276 -0.000782" rgba=".1 .2 .6 .5" size="0.0002"/>
            <site name="Brachialis_Insertion" pos="-0.000158 0.000938 -0.000585" rgba=".1 .2 .6 .5" size="0.0002"/>
            <site name="Biceps_Long_Insertion" pos="0.000295 0.001770 -0.000235" rgba=".1 .2 .6 .5" size="0.0002"/>

            <!-- Wrist landmark (tip of ulna, matching registration model) -->
            <!-- "wrist" is anatomically Shravan's N_L_C_right (carpal complex); kept as "wrist" for STAC config/script compatibility. -->
            <body name="wrist" pos="0 0.01092 0">
              <joint name="forearm_supination" type="hinge" pos="0 0 0" axis="0 1 0" range="-90 90" limited="true" damping="1e-3"/>
              <joint name="wrist_flexion" type="hinge" pos="0 0 0" axis="1 0 0" range="-60 60" limited="true" damping="1e-3"/>
              <joint name="rz_N_L_C_right" type="hinge" pos="0 0 0" axis="0 0 1" range="-15 15" limited="true" damping="1e-3"/>
                <!-- v21: density chosen to preserve combined mass=1e-4 kg across all 7
                     geoms; was an isotropic placeholder inertia (~17.32mm equivalent cube) -
                     now shaped from the actual carpal mesh geometry. -->
                <geom name="Navicular_lunate_right_bone" type="mesh" mesh="Navicular_lunate_right_bone" pos="0.00055734 0.00049810 -0.00055811" quat="0.22233320 0.10212090 0.01282941 0.96952291" material="bone" class="hand_visual" density="58706.12"/>
                <geom name="Pisiform_right_bone" type="mesh" mesh="Pisiform_right_bone" pos="0.00055734 0.00049810 -0.00055811" quat="0.22233320 0.10212090 0.01282941 0.96952291" material="bone" class="hand_visual" density="58706.12"/>
                <geom name="Triangular_right_bone" type="mesh" mesh="Triangular_right_bone" pos="0.00055734 0.00049810 -0.00055811" quat="0.22233320 0.10212090 0.01282941 0.96952291" material="bone" class="hand_visual" density="58706.12"/>
                <geom name="Hamate_right_bone" type="mesh" mesh="Hamate_right_bone" pos="0.00055734 0.00049810 -0.00055811" quat="0.22233320 0.10212090 0.01282941 0.96952291" material="bone" class="hand_visual" density="58706.12"/>
                <geom name="Falsiformis_right_bone" type="mesh" mesh="Falsiformis_right_bone" pos="0.00055734 0.00049810 -0.00055811" quat="0.22233320 0.10212090 0.01282941 0.96952291" material="bone" class="hand_visual" density="58706.12"/>
                <geom name="Centrale_right_bone" type="mesh" mesh="Centrale_right_bone" pos="0.00055734 0.00049810 -0.00055811" quat="0.22233320 0.10212090 0.01282941 0.96952291" material="bone" class="hand_visual" density="58706.12"/>
